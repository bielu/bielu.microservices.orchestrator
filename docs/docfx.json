{
  "metadata": [
    {
      "src": [
        {
          "src": "..",
          "files": [
            "src/**/*.csproj"
          ],
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "src/*.Examples.*/**",
            "**/*.Tests/**"
          ]
        }
      ],
      "dest": "api",
      "filter": "filterConfig.yml",
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "CNAME",
          "images/**",
          "public/**"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noIncrementalBuild": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false,
    "globalMetadata": {
      "_appName": "Bielu Microservices Orchestrator",
      "_appTitle": "Bielu Microservices Orchestrator",
      "_enableSearch": true,
      "_enableNewTab": true,
      "repository": "https://github.com/bielu/bielu.microservices.orchestrator",
      "docurl": "https://github.com/bielu/bielu.microservices.orchestrator/blob/main/docs"
    }
  }
}
